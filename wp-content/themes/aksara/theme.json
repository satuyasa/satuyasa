{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "slug": "ink",       "color": "#000000", "name": "Ink" },
				{ "slug": "paper",     "color": "#ffffff", "name": "Paper" },
				{ "slug": "mid-ink",   "color": "#18181d", "name": "Mid Ink" },
				{ "slug": "graphite",  "color": "#333333", "name": "Graphite" },
				{ "slug": "muted",     "color": "#767676", "name": "Muted Text" },
				{ "slug": "concrete",  "color": "#b7b7b7", "name": "Concrete" },
				{ "slug": "foam",      "color": "#ebedee", "name": "Foam" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fluid": false,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "ui",
					"name": "Sterling (UI)",
					"fontFamily": "'SterlingVF', 'Sterling', 'Work Sans', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "caption",    "size": "12px", "name": "Caption" },
				{ "slug": "body-sm",    "size": "14px", "name": "Body small" },
				{ "slug": "body",       "size": "16px", "name": "Body" },
				{ "slug": "heading",    "size": "28px", "name": "Heading" },
				{ "slug": "display",    "size": "115px", "name": "Display" },
				{ "slug": "display-lg", "size": "158px", "name": "Display large" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "12",  "size": "12px",  "name": "12" },
				{ "slug": "16",  "size": "16px",  "name": "16" },
				{ "slug": "20",  "size": "20px",  "name": "20" },
				{ "slug": "24",  "size": "24px",  "name": "24" },
				{ "slug": "36",  "size": "36px",  "name": "36" },
				{ "slug": "80",  "size": "80px",  "name": "80" },
				{ "slug": "112", "size": "112px", "name": "112" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false, "presets": [] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ui)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.5"
		},
		"spacing": {
			"padding": { "left": "24px", "right": "24px" },
			"blockGap": "24px"
		},
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"heading": {
				"typography": {
					"fontWeight": "500",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				}
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--paper)" },
				"border": { "radius": "6px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--ink)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--body-sm)", "fontWeight": "500" },
				"spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "24px", "right": "24px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--mid-ink)", "text": "var(--wp--preset--color--paper)" } }
			}
		},
		"blocks": {
			"core/separator": { "color": { "text": "var(--wp--preset--color--foam)" } },
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--body-sm)" },
				"color": { "background": "var(--wp--preset--color--foam)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--ink)", "width": "2px", "style": "solid" } },
				"spacing": { "padding": { "left": "24px" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-fonts",     "title": "Aksara — Font Library",   "postTypes": [ "page" ] },
		{ "name": "page-templates", "title": "Aksara — Canva Templates", "postTypes": [ "page" ] },
		{ "name": "page-elements",  "title": "Aksara — Canva Elements",  "postTypes": [ "page" ] },
		{ "name": "page-license",   "title": "Aksara — License",         "postTypes": [ "page" ] }
	]
}

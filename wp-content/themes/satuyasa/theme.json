{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "accent", "color": "#2563eb", "name": "Aksen" },
				{ "slug": "text", "color": "#1f2430", "name": "Teks" },
				{ "slug": "text-muted", "color": "#5b6472", "name": "Teks Muda" },
				{ "slug": "background", "color": "#ffffff", "name": "Latar" },
				{ "slug": "background-alt", "color": "#f5f7fa", "name": "Latar Alternatif" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"name": "Body"
				},
				{
					"slug": "heading",
					"fontFamily": "Georgia, 'Times New Roman', serif",
					"name": "Heading"
				}
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1140px"
		}
	}
}
